# Copy to .env or export these before running backend/app.py

# Camera shared by crowd / drowning / garbage modules.
# CAMERA_SOURCE options:
#   simulate                    -> no camera
#   0 / 1 / 3                   -> webcam, DroidCam Client or OBS Virtual Camera index
#                                  (run: python backend/camera_test.py to list them)
#   droidcam:172.28.11.95       -> DroidCam app over Wi-Fi (same Wi-Fi as the PC)
#   http://IP:4747/video        -> same thing as a full URL
#   C:\path\pool_video.mp4      -> test video (loops)
CAMERA_SOURCE=simulate
# Seconds before the first reconnect attempt (doubles up to 10 s)
CAMERA_RECONNECT_DELAY=2
# Open/read timeout for URL streams, in milliseconds
CAMERA_OPEN_TIMEOUT_MS=5000
# 1 = resize every frame to FRAME_WIDTH x FRAME_HEIGHT, 0 = keep native size
CAMERA_RESIZE=1

# Signs the login session cookie. Set a long random value, e.g. from:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random key is used per run (everyone is logged out on restart).
SECRET_KEY=

# Accounts: every user logs in and gets the features of their own plan
# (basic = crowd + water, pro = + drowning + reports, plus = + garbage + decision engine).
# Create the first admin with: python backend/manage.py create-admin
# DEMO_MODE=1 skips login and uses ACTIVE_PLAN for everyone (offline demo / CLI).
DEMO_MODE=0
ACTIVE_PLAN=plus

# PayHere recurring billing for Pro / Plus (USD, monthly). Leave empty to
# disable online payment (admins can still set plans on /admin/users).
# Merchant ID and secret are in the PayHere portal (Integrations); the
# secret is tied to the domain of PUBLIC_BASE_URL.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# 1 = sandbox.payhere.lk (test cards), 0 = live www.payhere.lk
PAYHERE_SANDBOX=1
# Public https URL PayHere can reach for /billing/notify, e.g. your ngrok URL
PUBLIC_BASE_URL=

# Water sensors: "simulate" or serial port (COM3, /dev/cu.usbmodem21401, /dev/ttyACM0)
SENSOR_SOURCE=simulate

# Models (defaults point at models/ folder)
# DROWNING_MODEL_PATH=models/drowning/best.pt
# CROWD_MODEL_PATH=models/crowd/best_swimmer_model.pt        # v1 (recommended)
# CROWD_MODEL_PATH=models/crowd/best_swimmer_model_v2_combined.pt
# GARBAGE_MODEL_PATH=models/garbage/best.pt

# Drowning detection
# Minimum confidence for a box to count (lower = more false alarms)
DROWNING_CONF_THRESHOLD=0.5
# How long (in camera frames) drowning must persist before an alert;
# converted to detector runs in app.py (minimum 5-run smoothing window)
DROWNING_CONSEC_FRAMES=10
# Inference size for the drowning model (best.pt was trained at 640)
DROWNING_IMGSZ=640
